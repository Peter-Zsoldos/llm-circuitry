class Pager:
    """Virtual memory for context: CLOCK eviction under a token budget, swap, dirty tracking."""
    def __init__(self, budget_tokens: int) -> None: ...
    def load(self, id: str, content: str, tokens: Optional[int] = None, pinned: bool = False) -> List[Dict[str, Any]]: ...
    def access(self, id: str) -> Dict[str, Any]: ...
    def write(self, id: str, content: str, tokens: Optional[int] = None) -> List[Dict[str, Any]]: ...
    def get(self, id: str) -> Dict[str, Any]: ...
    def pin(self, id: str) -> None: ...
    def unpin(self, id: str) -> None: ...
    def evict(self, id: str) -> Dict[str, Any]: ...
    def drop_page(self, id: str) -> Dict[str, Any]: ...
    def set_budget(self, budget_tokens: int) -> List[Dict[str, Any]]: ...
    def resident(self) -> List[str]: ...
    def swapped(self) -> List[str]: ...
    def dirty(self) -> List[str]: ...
    def clean(self, id: str) -> None: ...
    @property
    def used(self) -> int: ...
    @property
    def budget(self) -> int: ...
    def render(self) -> str: ...
    def stats(self) -> Dict[str, Any]: ...

class Signer:
