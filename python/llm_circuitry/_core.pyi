    def verify(self, envelope: Dict[str, Any]) -> bool: ...
    def grant(
        self,
        agent: str,
        actions: List[str],
        resources: Optional[List[str]] = None,
        ttl_seconds: Optional[float] = None,
        on_behalf_of: Optional[str] = None,
    ) -> str: ...
    def check(self, token: str, action: str, resource: str = "*") -> Dict[str, Any]: ...
    def inspect(self, token: str) -> Dict[str, Any]: ...

