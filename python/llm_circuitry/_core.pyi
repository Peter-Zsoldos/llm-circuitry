class BlobStore:
    """DMA for agents: content-addressed handles instead of copying data through context."""
    def __init__(self, capacity_bytes: Optional[int] = None) -> None: ...
    def put(self, data: Union[str, bytes], mime: str = "text/plain", label: str = "") -> str: ...
    def get(self, handle: str) -> bytes: ...
    def text(self, handle: str) -> str: ...
    def slice(self, handle: str, start: int = 0, end: Optional[int] = None) -> bytes: ...
    def lines(self, handle: str, start: int = 1, end: Optional[int] = None) -> str: ...
    def grep(self, handle: str, needle: str, max_results: int = 20) -> List[Dict[str, Any]]: ...
    def info(self, handle: str) -> Dict[str, Any]: ...
    def describe(self, handle: str, preview_chars: int = 120) -> str: ...
    def retain(self, handle: str) -> int: ...
    def release(self, handle: str) -> int: ...
    def delete(self, handle: str) -> None: ...
    def handles(self) -> List[str]: ...
    def stats(self) -> Dict[str, Any]: ...
    def __contains__(self, handle: str) -> bool: ...

class AddressableDoc:
