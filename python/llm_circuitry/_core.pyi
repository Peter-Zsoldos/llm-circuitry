from typing import Any, Dict, List, Literal, Optional, Sequence, Union

__version__: str

RingLike = Union[int, str]
Json = Any

class CircuitError(Exception): ...
class NotFoundError(CircuitError): ...
class StaleError(CircuitError): ...
class ConflictError(CircuitError): ...
class CapacityError(CircuitError): ...
class InvalidStateError(CircuitError): ...
class IntegrityError(CircuitError): ...
class DeniedError(CircuitError): ...
class ValidationError(CircuitError): ...

def scan_injection(text: str) -> List[Dict[str, Any]]: ...
def estimate_tokens(text: str) -> int: ...
def glob_match(pattern: str, text: str) -> bool: ...

class ProtectedContext:
    """Context window with privilege rings (MMU / NX bit), taint tracking and an action policy."""
    def __init__(self) -> None: ...
    @property
    def boundary(self) -> str: ...
    def push(self, ring: RingLike, source: str, content: str) -> int: ...
    def derive(self, source: str, content: str, derived_from: Sequence[int]) -> int: ...
    def get(self, id: int) -> Dict[str, Any]: ...
    def segments(self) -> List[Dict[str, Any]]: ...
    def remove(self, id: int) -> Dict[str, Any]: ...
    def set_rule(self, action: str, max_ring: RingLike, on_violation: Literal["require_approval", "deny"] = "require_approval") -> None: ...
    def set_default_rule(self, max_ring: RingLike, on_violation: Literal["require_approval", "deny"] = "require_approval") -> None: ...
    def set_alert_severity(self, severity: int) -> None: ...
    def check(self, action: str, derived_from: Sequence[int]) -> Dict[str, Any]: ...
    def preamble(self) -> str: ...
    def render_segment(self, id: int) -> str: ...
    def render(self) -> str: ...
    def __len__(self) -> int: ...

class TransactionManager:
    """Write-ahead, hash-chained journal of agent actions (journaling filesystem)."""
    def __init__(self, path: Optional[str] = None) -> None: ...
    def begin(self, label: str) -> int: ...
    def step(self, txn: int, name: str, params: Json = None, compensation: Optional[str] = None) -> int: ...
    def done(self, txn: int, step: int, result: Json = None) -> None: ...
    def fail(self, txn: int, step: int, error: str) -> None: ...
    def commit(self, txn: int) -> None: ...
    def begin_rollback(self, txn: int, reason: str) -> List[Dict[str, Any]]: ...
    def compensated(self, txn: int, step: int) -> None: ...
    def compensation_failed(self, txn: int, step: int, error: str) -> None: ...
    def finish_rollback(self, txn: int) -> str: ...
    def get(self, txn: int) -> Dict[str, Any]: ...
    def list(self) -> List[Dict[str, Any]]: ...
    def recover(self) -> List[Dict[str, Any]]: ...
    def journal(self) -> List[Dict[str, Any]]: ...
    def verify(self) -> None: ...

class CoherentStore:
    """Versioned shared state with MESI-style stale-read detection between agents."""
    def __init__(self) -> None: ...
    def read(self, agent: str, key: str) -> Optional[Dict[str, Any]]: ...
    def get(self, key: str) -> Optional[Dict[str, Any]]: ...
    def write(self, agent: str, key: str, value: Json, expected_version: Optional[int] = None) -> int: ...
    def validate(self, agent: str, keys: Optional[List[str]] = None) -> List[Dict[str, Any]]: ...
    def require_fresh(self, agent: str, keys: Optional[List[str]] = None) -> None: ...
    def state(self, agent: str, key: str) -> Literal["modified", "exclusive", "shared", "invalid"]: ...
    def invalidations(self, agent: str) -> List[Dict[str, Any]]: ...
    def lock(self, agent: str, key: str, ttl_seconds: float = 30.0) -> None: ...
    def unlock(self, agent: str, key: str) -> None: ...
    def keys(self) -> List[str]: ...

class InterruptController:
    """Prioritised, maskable interrupts. Priority 255 is non-maskable."""
    def __init__(self) -> None: ...
    def raise_interrupt(self, priority: int, source: str, message: str, payload: Json = None) -> int: ...
    def set_mask(self, level: int) -> None: ...
    @property
    def mask(self) -> int: ...
    def has_pending(self, min_priority: int = 0) -> bool: ...
    def pending(self) -> List[Dict[str, Any]]: ...
    def masked(self) -> List[Dict[str, Any]]: ...
    def poll(self) -> Optional[Dict[str, Any]]: ...
    def drain(self) -> List[Dict[str, Any]]: ...
    def drain_text(self) -> List[str]: ...
    def clear(self) -> int: ...

class Watchdog:
    """Budgets, stall detection and loop/cycle detection for agent loops."""
    def __init__(
        self,
        max_steps: Optional[int] = None,
        max_seconds: Optional[float] = None,
        max_tokens: Optional[int] = None,
        stall_steps: Optional[int] = None,
        loop_repeats: int = 3,
        max_period: int = 3,
        warn_ratio: float = 0.8,
    ) -> None: ...
    def tick(self, signature: str, tokens: int = 0) -> Dict[str, Any]: ...
    def progress(self) -> None: ...
    def reset(self) -> None: ...
    @property
    def tripped(self) -> Optional[str]: ...
    def stats(self) -> Dict[str, Any]: ...

class Clock:
    """Real-time clock for the model: wall time, elapsed time, deadline."""
    def __init__(self, deadline_seconds: Optional[float] = None) -> None: ...
    def now_iso(self) -> str: ...
    def started_iso(self) -> str: ...
    def elapsed(self) -> float: ...
    def remaining(self) -> Optional[float]: ...
    def set_deadline(self, seconds: Optional[float] = None) -> None: ...
    def note(self) -> str: ...

class ExecStack:
    """Program counter and call stack of goals, kept outside the context window."""
    def __init__(self, max_depth: int = 16) -> None: ...
    def push(self, goal: str) -> int: ...
    def step(self, description: str) -> int: ...
    def note(self, text: str) -> None: ...
    def pop(self, result: Json = None) -> Dict[str, Any]: ...
    def fail(self, error: str) -> Dict[str, Any]: ...
    def unwind_to(self, frame_id: int, reason: str) -> List[Dict[str, Any]]: ...
    def current(self) -> Optional[Dict[str, Any]]: ...
    @property
    def depth(self) -> int: ...
    def frames(self) -> List[Dict[str, Any]]: ...
    def finished(self) -> List[Dict[str, Any]]: ...
    def breadcrumb(self) -> str: ...
    def render(self) -> str: ...
    def to_json(self) -> str: ...
    @staticmethod
    def from_json(s: str) -> "ExecStack": ...
    def __len__(self) -> int: ...

class Verifier:
